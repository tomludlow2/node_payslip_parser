PGHOST=localhost
PGPORT=5432
PGDATABASE=payslips_db
PGUSER=payslip_user
PGPASSWORD=
# Existing users.id; both login methods must already belong to this record.
OWNER_ID=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
NODE_ENV=production
HOST=127.0.0.1
PORT=52535
# Set only to the actual reverse proxy address/CIDR, e.g. loopback.
TRUST_PROXY=loopback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://pay.tomoutlaw.co.uk/auth/google/callback
# Server base URL, without /remote.php/dav. HTTPS is required.
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
# Relative to the Nextcloud user's files root; subfolders are included.
NEXTCLOUD_FOLDER=Payslips
