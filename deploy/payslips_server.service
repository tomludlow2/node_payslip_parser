[Unit]
Description=Personal payslip application
After=network.target postgresql.service

[Service]
User=tom
WorkingDirectory=/var/www/pay
Environment=NODE_ENV=production
EnvironmentFile=/var/www/pay/.env
ExecStart=/usr/bin/node /var/www/pay/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/pay/payslips /var/www/pay/tempFileDir

[Install]
WantedBy=multi-user.target
