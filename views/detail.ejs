<%- include('partials/head') %><header class="page-heading"><div><p class="eyebrow">THE FULL PICTURE</p><h1>Paid <%= date(p.pay_date) %></h1><p><%= p.categories?.job_title||p.job?.job_title||'Payslip' %> · <%= p.categories?.department||p.job?.department||'' %></p></div><a class="button secondary" href="/documents/<%= p.id %>" target="_blank" rel="noopener">Open original PDF ↗</a></header><div class="metric-grid"><section class="metric primary"><p>Take-home pay</p><h2><%= gbp(p.net_pay) %></h2></section><section class="metric"><p>Gross pay</p><h2><%= gbp(p.total_payments) %></h2></section><section class="metric"><p>Deductions</p><h2><%= gbp(p.total_deductions) %></h2></section></div><section class="panel"><h2>Employment categories</h2><dl><dt>Grade</dt><dd><%= p.categories.grade||'Unknown — awaiting mapping' %></dd><dt>Location</dt><dd><%= p.categories.location||'Unknown — awaiting mapping' %></dd><dt>Locum type</dt><dd><%= p.categories.locum_type||(p.categories.grade==='Locum'?'Unknown — awaiting mapping':'Not a locum classification') %></dd><dt>Department</dt><dd><%= p.categories.department||'Unknown' %></dd><dt>Payscale descriptor</dt><dd><%= p.categories.payscale_descriptor||'Unknown' %></dd></dl><p>The original extracted fields and PDF are retained below.</p></section><div class="detail-grid"><% for(const section of ['pay_lines','deduction_lines','demographics','job','wage','tax','this_period_summary','year_to_date']){ %><section class="panel"><h2><%= section.replace(/_/g,' ') %></h2><% if(Array.isArray(p[section])){ %><div class="table-scroll"><table><thead><tr><th>Description</th><th>Worked</th><th>Paid</th><th>Rate</th><th>Amount</th></tr></thead><tbody><% p[section].forEach(l=>{ %><tr><td><%= l.Description %></td><td><%= l.Worked %></td><td><%= l.Paid %></td><td><%= l.Rate %></td><td><%= gbp(l.Amount) %></td></tr><% }) %></tbody></table></div><% }else{ %><dl><% Object.entries(p[section]||{}).forEach(([k,v])=>{ %><dt><%= k.replace(/_/g,' ') %></dt><dd><%= v??'—' %></dd><% }) %></dl><% } %></section><% } %></div><section class="panel"><h2>Version history</h2><% if(!versions.length){ %><p class="muted">This legacy payslip has not been revised since version tracking was enabled.</p><% } %><% versions.forEach(v=>{ %><details class="comparison"><summary><%= date(v.created_at) %> · <%= gbp(v.data.net_pay) %></summary><% if(v.storage_name){ %><a href="/versions/<%= v.id %>/document" target="_blank" rel="noopener">Open this version’s PDF ↗</a><% } %><pre><%= JSON.stringify(v.data,null,2) %></pre></details><% }) %></section><%- include('partials/foot') %>
