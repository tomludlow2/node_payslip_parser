<%- include('partials/head') %><header class="page-heading"><div><p class="eyebrow">LESS ADMIN. MORE CLARITY.</p><h1>Imports & sync</h1><p>Your uploads and Nextcloud activity, all in one place.</p></div><button class="button" id="sync-now" <%= !nextcloud?'disabled':'' %>>↻ Sync now</button></header><section class="panel sync-banner"><div><h2>Nextcloud <span class="badge"><%= nextcloud?'Configured':'Not connected' %></span></h2><p><%= state?.error||'New and changed PDFs are checked every five minutes when the worker timer is enabled.' %></p><small>Last completed: <%= date(state?.last_completed) %> <%= state?.last_completed?new Date(state.last_completed).toLocaleTimeString('en-GB',{timeZone:'Europe/London'}):'' %></small></div><div><span class="status-dot"></span><%= state?.requested?'Sync requested':state?.error?'Needs attention':nextcloud?'Ready':'Awaiting configuration' %></div></section><p id="sync-status" role="status"></p><section class="panel"><div class="panel-heading"><h2>Import activity</h2><span class="muted">Latest 200 attempts</span></div><div class="table-scroll"><table><thead><tr><th>Document</th><th>Source</th><th>Status</th><th>Last attempt</th><th></th></tr></thead><tbody><% data.forEach(a=>{ %><tr><td><strong><%= a.filename %></strong><% if(a.errors?.length){ %><small><%= a.errors[0].message %></small><% } %></td><td><%= a.kind==='nextcloud'?'Nextcloud':'Manual upload' %></td><td><span class="badge <%= a.status %>"><%= a.status %></span></td><td><%= date(a.updated_at) %></td><td><a href="/imports/<%= a.id %>">Details →</a></td></tr><% }) %></tbody></table></div><% if(!data.length){ %><div class="empty"><span>↻</span><h3>A fresh start</h3><p>Your import activity will appear here.</p><a class="button" href="/upload">Upload your first payslip</a></div><% } %></section><%- include('partials/foot') %>
