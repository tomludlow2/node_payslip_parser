<form class="filters" method="get"><label>Year type<select name="yearType"><option value="tax" <%= type==='tax'?'selected':'' %>>Tax year</option><option value="academic" <%= type==='academic'?'selected':'' %>>Academic year</option></select></label><label>Starting year<input name="year" type="text" inputmode="numeric" placeholder="Year or all" value="<%= year %>"></label><label>Grade<select name="grade"><option value="">All grades</option><% [...gradeOptions,'Unknown'].forEach(v=>{ %><option value="<%= v %>" <%= grade===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Location<select name="location"><option value="">All locations</option><% [...locationOptions,'Unknown'].forEach(v=>{ %><option value="<%= v %>" <%= location===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Locum type<select name="locumType"><option value="">All types</option><% [...locumOptions,'Unknown'].forEach(v=>{ %><option value="<%= v %>" <%= locumType===v?'selected':'' %>><%= v==='Unknown'?'Unclassified locum':v %></option><% }) %></select></label><button class="button secondary">Apply</button><small>Enter “all” for every year.</small></form>
