<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="<%= csrf %>"><title><%= title %> · Paybook</title><link rel="stylesheet" href="/assets/app.css"><script src="/assets/app.js" defer></script></head><body>
<% if(user) { %><aside class="sidebar"><a class="brand" href="/dashboard"><span class="brand-mark">p.</span>paybook<span class="brand-dot">●</span></a><p class="nav-caption">YOUR WORK. YOUR PAY.</p><nav aria-label="Main navigation"><a class="<%= current==='/dashboard'?'active':'' %>" href="/dashboard"><span aria-hidden="true">▦</span> Overview</a><a class="<%= current==='/payslip_table'||current==='/view_payslip'?'active':'' %>" href="/payslip_table"><span aria-hidden="true">▤</span> Payslip library</a><a class="<%= current.startsWith('/imports')?'active':'' %>" href="/imports"><span aria-hidden="true">↻</span> Imports & sync</a><a class="<%= current==='/upload'?'active':'' %>" href="/upload"><span aria-hidden="true">＋</span> Upload a payslip</a></nav><div class="sidebar-foot"><span class="avatar"><%= user.username.slice(0,1).toUpperCase() %></span><div><strong><%= user.username %></strong><small>Personal workspace</small></div><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button" aria-label="Sign out">Sign out ↗</button></form></div></aside><main class="main"><div class="topbar"><span>PERSONAL FINANCES</span><span class="privacy">● Private workspace</span></div><% } else { %><main class="auth-main"><a class="brand" href="/"><span class="brand-mark">p.</span>paybook</a><% } %>
<% if(notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
