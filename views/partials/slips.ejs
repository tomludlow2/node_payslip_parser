<div class="table-scroll"><table><thead><tr><th>Pay date</th><th>Role & department</th><th class="number">Gross pay</th><th class="number">Deductions</th><th class="number">Take-home</th><th><span class="sr-only">Details</span></th></tr></thead><tbody><% data.forEach(p=>{ %><tr data-search-row><td><a class="date-link" href="/view_payslip?payslip_id=<%= p.id %>"><%= date(p.pay_date) %></a><small><%= p.filename %></small></td><td><%= p.categories?.job_title||p.job?.job_title||'—' %><small><%= p.categories?.department||p.job?.department||'—' %></small><% if(p.categories){ %><small><%= p.categories.grade||'Grade unclassified' %> · <%= p.categories.location||'Location unclassified' %><%= p.categories.locum_type?' · '+p.categories.locum_type:'' %></small><% } %></td><td class="number"><%= gbp(p.total_payments) %></td><td class="number muted"><%= gbp(p.total_deductions) %></td><td class="number strong"><%= gbp(p.net_pay) %></td><td><a class="round-link" aria-label="View payslip dated <%= date(p.pay_date) %>" href="/view_payslip?payslip_id=<%= p.id %>">↗</a></td></tr><% }) %></tbody></table></div><% if(!data.length){ %><div class="empty"><span>▤</span><h3>No payslips in this period</h3><p>Choose another year or import your first payslip.</p><a class="button" href="/upload">Upload a payslip</a></div><% } %><p class="empty search-empty" hidden>No payslips match your search.</p>
